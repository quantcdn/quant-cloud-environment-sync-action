{
  "name": "quant-cloud-environment-sync-action",
  "version": "1.0.0",
  "description": "GitHub Action for syncing data between environments in Quant Cloud",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts",
    "test": "jest",
    "prepare": "husky"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@quantcdn/quant-client": "^4.12.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.38.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@actions/core$": "<rootDir>/node_modules/@actions/core/lib/core.js"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "moduleResolution": "Node"
          }
        }
      ]
    }
  }
}
